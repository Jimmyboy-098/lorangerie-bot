# Copia este archivo como .env y llena los valores

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886

# Número de WhatsApp del restaurante (para recibir notificaciones de reservaciones)
RESTAURANT_WHATSAPP_NUMBER=+521234567890

# Tu número personal de WhatsApp (sin whatsapp:, solo el número con código de país)
# Ejemplo: +526561234567
# Desde este número puedes usar /broadcast, /reservaciones, /suscriptores, /ayuda
ADMIN_WHATSAPP=+52XXXXXXXXXX

# Token secreto para los endpoints HTTP de administración (/admin/broadcast, /admin/reservations)
# Puedes poner cualquier texto largo y difícil de adivinar
ADMIN_TOKEN=tu-token-secreto-aqui

# Google Calendar (opcional — deja en blanco si no lo usas)
# Para obtener estos valores: ve a Google Cloud Console → APIs → Calendar API → Cuentas de servicio
# El JSON de la cuenta de servicio debe estar codificado en base64:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("credentials.json"))
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID del calendario donde se crearán los eventos (o "primary" para el calendario principal)
# Lo encuentras en Google Calendar → Configuración del calendario → Integrar calendario → ID del calendario
GOOGLE_CALENDAR_ID=primary

# Puerto (Render lo asigna automáticamente)
PORT=3000
